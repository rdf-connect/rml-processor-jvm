@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.

rdfc:RmlMapper a rdfs:Class, owl:Class;
  rdfc:javaImplementationOf rdfc:Processor;
  rdfc:class "org.example.App";
  rdfc:jar <>.

[ ] a sh:NodeShape;
  sh:targetClass <Source>;
  sh:property [
    sh:path rdfc:reader;
    sh:codeIdentifier "reader";
    sh:name "Reader";
    sh:minCount 1;
    sh:maxCount 1;
    sh:class rdfc:Reader;
  ], [
    sh:path rdfc:mappingId;
    sh:codeIdentifier "mappingId";
    sh:name "Mapping identifier";
    sh:maxCount 1;
    sh:datatype xsd:string;
  ], [
    sh:path rdfc:triggers;
    sh:codeIdentifier "triggers";
    sh:name "Triggers";
    sh:maxCount 1;
    sh:datatype xsd:boolean;
  ].

[ ] a sh:NodeShape;
  sh:targetClass <Target>;
  sh:property [
    sh:path rdfc:writer;
    sh:codeIdentifier "writer";
    sh:name "Writer";
    sh:minCount 1;
    sh:maxCount 1;
    sh:class rdfc:Writer;
  ], [
    sh:path rdfc:mappingId;
    sh:codeIdentifier "mappingId";
    sh:name "Mapping identifier";
    sh:maxCount 1;
    sh:datatype xsd:string;
  ], [
    sh:path rdfc:format;
    sh:codeIdentifier "format";
    sh:name "Format";
    sh:maxCount 1;
    sh:datatype xsd:string;
  ].

[ ] a sh:NodeShape;
  sh:targetClass <DefaultTarget>;
  sh:property [
    sh:path rdfc:writer;
    sh:codeIdentifier "writer";
    sh:name "Writer";
    sh:minCount 1;
    sh:maxCount 1;
    sh:class rdfc:Writer;
  ], [
    sh:path rdfc:format;
    sh:codeIdentifier "format";
    sh:name "Format";
    sh:maxCount 1;
    sh:datatype xsd:string;
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfc:RmlMapper;
  sh:property [
    sh:path rdfc:mappings;
    sh:codeIdentifier "mappings";
    sh:name "Mappings";
    sh:minCount 1;
    sh:maxCount 1;
    sh:class rdfc:Reader;
  ], [
    sh:path rdfc:baseIRI;
    sh:codeIdentifier "baseIRI";
    sh:name "Base IRI";
    sh:maxCount 1;
    sh:datatype xsd:string;
  ], [
    sh:path rdfc:waitForMappingClose;
    sh:codeIdentifier "waitForMappingClose";
    sh:name "Wait for mapping close";
    sh:maxCount 1;
    sh:datatype xsd:boolean;
  ], [
    sh:path rdfc:defaultTarget;
    sh:codeIdentifier "defaultTarget";
    sh:name "Default target";
    sh:maxCount 1;
    sh:class <DefaultTarget>;
  ], [
    sh:path rdfc:source;
    sh:codeIdentifier "sources";
    sh:name "Sources";
    sh:class <Source>;
  ], [
    sh:path rdfc:target;
    sh:codeIdentifier "targets";
    sh:name "Targets";
    sh:class <Target>;
  ].

